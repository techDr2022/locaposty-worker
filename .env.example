# Worker environment variables
# Copy to .env in project root

# Database (PostgreSQL - same as main app)
DATABASE_URL=
DB_OP_RETRIES=3
DB_OP_RETRY_DELAY_MS=1500

# Redis (required for BullMQ) — use REDIS_URL or separate host/port/password
REDIS_URL=
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=

# Google GMB OAuth (for token refresh when publishing)
GOOGLE_CLIENT_ID_GMB=
GOOGLE_CLIENT_SECRET_GMB=
NEXTAUTH_URL=

# Optional: Worker port for health check (default 3002)
# PORT=3002
REPORTS_WORKER_PORT=3002

# DB startup retries (optional)
# DB_READY_RETRIES=30
# DB_READY_RETRY_DELAY_MS=3000

# Resend email delivery
RESEND_API_KEY=
FROM_EMAIL=reports@example.com

# S3 report storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Chromium pack URL for production PDF rendering
CHROMIUM_PACK_URL=
